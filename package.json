{
  "name": "dsh-aha-tail",
  "version": "0.2.1",
  "description": "Every finished reply in the DeepSeek Harness Web UI gets a sticker from a bundled sticker pack; click to swap. Bring your own folder too.",
  "type": "module",
  "license": "MIT",
  "author": "chenhw-hjm",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "sticker",
    "sticker-pack",
    "emoji",
    "chat",
    "meme"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chenhw-hjm/dsh-aha-tail.git"
  },
  "bugs": {
    "url": "https://github.com/chenhw-hjm/dsh-aha-tail/issues"
  },
  "homepage": "https://github.com/chenhw-hjm/dsh-aha-tail#readme",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "scan.js",
    "client.js",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "assets",
    "README.md",
    "PUBLISH.md",
    "LICENSE"
  ],
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
